clear
clc
close all
t = 0:0.1:5;
y1 = sin(t).*cos(t).^2./(t.^2+1);
y2 = sqrt(t.^3)*exp(2);
plot(t,y1,'b',Linewidth=2);
hold on
plot(t,y2,'y',LineWidth=3);
legend('y1','y2');
title('A');
xlable('x');
ylabel('y');
grid on;
x = -2:0.05:2;
f = sin(x).^2 + 2*x.*sin(x);
Z=cos(x).^2 + cosh(x).^2;
k = x.^2 + 2*x.*sin(x);
subplot(1,3,1);
plot(x,f);
title('1');
subplot(1,3,2);
plot(x,Z);
title('2');
subplot(1,3,3);
plot(x,k);
title('3');

